# --- Datos ------------------------------------------------------------------
# El CSV crudo de SECOP II pesa cientos de MB: excede el límite de GitHub y no
# aporta nada al repo, porque el pipeline lo reconstruye desde la API.
data/raw/*.csv
 
# La tabla de hechos pesa ~53 MB: excede el límite cómodo de GitHub, así que
# se ignora y en su lugar se versiona una muestra aleatoria de 5.000 contratos.
# Las dimensiones sí se suben: son pequeñas y permiten inspeccionar el modelo
# sin necesidad de correr el pipeline completo.
data/processed/hechos_contratos.csv
 
# Se conservan las carpetas vacías en el repo
!data/raw/.gitkeep
!data/processed/.gitkeep
 
# Sí se sube la muestra pequeña, si la generas (ver README)
!data/muestra_*.csv
 
# --- Credenciales -----------------------------------------------------------
# Nunca subir el token de Socrata ni ninguna credencial
.env
.env.*
*.token
secrets.json
 
# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/
 
# --- Power BI ---------------------------------------------------------------
# Archivos temporales de bloqueo que crea Power BI Desktop al abrir un .pbix
~$*.pbix
*.pbix.bak
 
# --- Sistema operativo ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini